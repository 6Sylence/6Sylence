{%- doc -%}
  Sección de reseñas de producto.
  Renderiza el widget de reseñas de Judge.me (la app ya está instalada como
  app embed) y admite bloques de app como alternativa. Si en el futuro se añade
  el bloque oficial de Judge.me desde el editor, desactiva "Mostrar widget de
  Judge.me" para no duplicarlo.
{%- enddoc -%}

<div class="section-background"></div>
<div class="section section--{{ section.settings.section_width }} product-reviews-section" id="reviews">
  <div
    class="product-reviews spacing-style"
    style="{% render 'spacing-style', settings: section.settings %}"
  >
    {%- if section.settings.heading != blank -%}
      <h2 class="product-reviews__heading h3">{{ section.settings.heading | escape }}</h2>
    {%- endif -%}

    {% content_for 'blocks' %}

    {%- if section.settings.show_judgeme_widget and product != blank -%}
      <div
        id="judgeme_product_reviews"
        class="jdgm-widget jdgm-review-widget"
        data-id="{{ product.id }}"
        data-product-title="{{ product.title | escape }}"
      ></div>
    {%- endif -%}
  </div>
</div>

{% stylesheet %}
  .product-reviews {
    display: flex;
    flex-direction: column;
    gap: var(--gap-lg);
  }

  .product-reviews__heading {
    margin: 0;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Reseñas de producto",
  "class": "section-wrapper",
  "enabled_on": {
    "templates": ["product"]
  },
  "blocks": [
    {
      "type": "@app"
    }
  ],
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:settings.heading",
      "default": "Reseñas"
    },
    {
      "type": "checkbox",
      "id": "show_judgeme_widget",
      "label": "Mostrar widget de Judge.me",
      "info": "Requiere la app Judge.me instalada (ya activa como app embed). Desactívalo si añades el bloque de app oficial para no duplicar.",
      "default": true
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "t:settings.width",
      "options": [
        { "value": "page-width", "label": "t:options.page" },
        { "value": "full-width", "label": "t:options.full" }
      ],
      "default": "page-width"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 48
    }
  ],
  "presets": [
    {
      "name": "Reseñas de producto"
    }
  ]
}
{% endschema %}
